# Copy to .env and fill in what you need.
#
# Every variable here is optional and has a fallback, so the project builds and
# runs with no .env at all. .env is gitignored; on Netlify these are set in the
# site's environment variables, never in the repository.
#
# Only VITE_-prefixed variables reach the browser. Anything you put here is
# public — never put a secret in this file or in .env.

# Canonical origin, for absolute og:image / og:url / canonical metadata.
# Defaults to the production domain. On Netlify, set this from the deploy's own
# URL so deploy previews do not advertise the production domain in their
# metadata.
# VITE_SITE_URL=https://rowanvale.photo

# Public base URL of the R2 bucket serving photograph variants, no trailing
# slash. Leave unset to serve the bundled placeholder assets instead.
# See docs/IMAGES.md.
# VITE_IMAGE_BASE_URL=https://images.rowanvale.photo
